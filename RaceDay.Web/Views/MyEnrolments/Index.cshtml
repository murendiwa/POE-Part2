@model List<EnrolmentDto>
@{
    ViewData["Title"] = "My enrolments";
}
<div class="rd-card-header"><h1 class="mb-0">My enrolments</h1></div>

@if (Model.Count == 0)
{
    <div class="rd-card text-center py-5">
        <h3>No enrolments yet</h3>
        <p class="text-muted mb-4">Find a race and sign up.</p>
        <a asp-controller="Events" asp-action="Index" class="btn btn-rd">Browse events</a>
    </div>
}
else
{
    <div class="rd-card">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead>
                    <tr><th>Event</th><th>Date</th><th>Category</th><th>Fee</th><th>Status</th><th>Payment</th><th></th></tr>
                </thead>
                <tbody>
                    @foreach (var e in Model)
                    {
                        <tr>
                            <td class="fw-semibold">
                                <a asp-controller="Events" asp-action="Details" asp-route-id="@e.EventId">@e.EventName</a>
                            </td>
                            <td>@e.EventDate.ToString("dd MMM yyyy")</td>
                            <td>@e.CategoryName</td>
                            <td>R@(e.EntryFee.ToString("0.00"))</td>
                            <td><partial name="_StatusBadge" model="e.Status" /></td>
                            <td><partial name="_StatusBadge" model="e.PaymentStatus" /></td>
                            <td class="text-end">
                                @if (e.Status != "Cancelled" && e.EventDate > DateTime.Now)
                                {
                                    <form asp-action="Cancel" asp-route-id="@e.EnrolmentId" method="post" class="d-inline"
                                          onsubmit="return confirm('Cancel this enrolment?');">
                                        <button type="submit" class="btn btn-rd-outline btn-sm">Cancel</button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}