@model EventEnrolmentsViewModel
@{
    var ev = Model.Event;
    ViewData["Title"] = "Enrolments: " + ev.Name;
}
<a asp-controller="OrganiserEvents" asp-action="Index" class="text-decoration-none">&larr; My events</a>
<div class="d-flex flex-wrap justify-content-between align-items-end gap-2 mt-3 mb-3">
    <div class="rd-card-header mb-0">
        <h1 class="mb-0">Enrolments</h1>
        <div class="rd-meta">@ev.Name &middot; @ev.EventDate.ToString("dd MMM yyyy")</div>
    </div>
    <form method="get" asp-action="Index" class="d-flex gap-2 align-items-center">
        <input type="hidden" name="eventId" value="@ev.EventId" />
        <select name="status" class="form-select form-select-sm" aria-label="Filter by status">
            <option value="">All statuses</option>
            @foreach (var s in EventEnrolmentsViewModel.EnrolmentStatuses)
            {
                <option value="@s" selected="@(s == Model.StatusFilter)">@s</option>
            }
        </select>
        <button type="submit" class="btn btn-rd btn-sm">Filter</button>
    </form>
</div>

@if (Model.Enrolments.Count == 0)
{
    <div class="rd-card text-center py-5">
        <h3>No enrolments</h3>
        <p class="text-muted mb-0">Nobody has enrolled for this event@(string.IsNullOrEmpty(Model.StatusFilter) ? "" : " with that status") yet.</p>
    </div>
}
else
{
    <div class="rd-card">
        <p class="text-muted small">@Model.Enrolments.Count enrolment(s)</p>
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead>
                    <tr><th>Participant</th><th>Category</th><th>Enrolled</th><th>Fee</th><th>Status</th><th>Payment</th><th>Update</th></tr>
                </thead>
                <tbody>
                @foreach (var e in Model.Enrolments)
                {
                    <tr>
                        <td class="fw-semibold">@e.ParticipantName</td>
                        <td>@e.CategoryName</td>
                        <td>@e.EnrolmentDate.ToString("dd MMM yyyy")</td>
                        <td>R@(e.EntryFee.ToString("0.00"))</td>
                        <td><partial name="_StatusBadge" model="e.Status" /></td>
                        <td><partial name="_StatusBadge" model="e.PaymentStatus" /></td>
                        <td>
                            <form asp-action="Update" asp-route-id="@e.EnrolmentId" method="post" class="d-flex gap-1">
                                <input type="hidden" name="eventId" value="@ev.EventId" />
                                <input type="hidden" name="filter" value="@Model.StatusFilter" />
                                <select name="status" class="form-select form-select-sm" aria-label="Status">
                                    @foreach (var s in EventEnrolmentsViewModel.EnrolmentStatuses)
                                    {
                                        <option value="@s" selected="@(s == e.Status)">@s</option>
                                    }
                                </select>
                                <select name="paymentStatus" class="form-select form-select-sm" aria-label="Payment status">
                                    @foreach (var p in EventEnrolmentsViewModel.PaymentStatuses)
                                    {
                                        <option value="@p" selected="@(p == e.PaymentStatus)">@p</option>
                                    }
                                </select>
                                <button type="submit" class="btn btn-rd btn-sm">Save</button>
                            </form>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
}
