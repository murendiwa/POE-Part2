@model EventDetailsViewModel
@{
    var ev = Model.Event;
    ViewData["Title"] = ev.Name;
    var canEnrol = ev.Status == "Scheduled" && ev.EventDate > DateTime.Now;
}
<a asp-action="Index" class="text-decoration-none">&larr; All events</a>

<div class="rd-card rd-event-card mt-3">
    @if (!string.IsNullOrWhiteSpace(ev.BannerUrl))
    {
        <img src="@ev.BannerUrl" class="rd-event-banner rd-event-banner-lg" alt="Banner for @ev.Name" />
    }
    else
    {
        <div class="rd-event-banner rd-event-banner-lg rd-event-placeholder"><span>@ev.Name</span></div>
    }
    <div class="p-4">
        <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
            <h1 class="mb-0">@ev.Name</h1>
            @if (ev.Status != "Scheduled")
            {
                <partial name="_StatusBadge" model="ev.Status" />
            }
        </div>
        <div class="rd-meta">@ev.EventDate.ToString("dddd, dd MMMM yyyy 'at' HH:mm")</div>
        <div class="rd-meta">@ev.Location@(string.IsNullOrWhiteSpace(ev.Province) ? "" : ", " + ev.Province)</div>
        @if (!string.IsNullOrWhiteSpace(ev.OrganiserName))
        {
            <div class="rd-meta">Organised by @ev.OrganiserName</div>
        }
        @if (!string.IsNullOrWhiteSpace(ev.Description))
        {
            <p class="mt-3 mb-0">@ev.Description</p>
        }
    </div>
</div>

<div class="rd-card mt-4">
    <div class="rd-card-header"><h2 class="mb-0">Categories</h2></div>

    @if (ev.Categories is null || ev.Categories.Count == 0)
    {
        <p class="text-muted mb-0">The organiser hasn't added any categories yet.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead>
                    <tr><th>Category</th><th>Distance</th><th>Max participants</th><th>Entry fee</th><th></th></tr>
                </thead>
                <tbody>
                    @foreach (var c in ev.Categories)
                    {
                        <tr>
                            <td class="fw-semibold">@c.Name</td>
                            <td>@c.DistanceKm.ToString("0.##") km</td>
                            <td>@c.MaxParticipants</td>
                            <td>R@(c.EntryFee.ToString("0.00"))</td>
                            <td class="text-end">
                                @if (Model.EnrolledCategoryIds.Contains(c.CategoryId))
                                {
                                    <span class="rd-status rd-status-confirmed">Enrolled</span>
                                }
                                else if (canEnrol)
                                {
                                    <form asp-action="Enrol" method="post" class="d-inline">
                                        <input type="hidden" name="eventId" value="@ev.EventId" />
                                        <input type="hidden" name="categoryId" value="@c.CategoryId" />
                                        <button type="submit" class="btn btn-rd btn-sm">Enrol</button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>