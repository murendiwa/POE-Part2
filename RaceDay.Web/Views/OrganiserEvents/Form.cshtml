@model EventFormViewModel
@{
    var isNew = Model.EventId == 0;
    ViewData["Title"] = isNew ? "Create event" : "Edit event";
}
<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="rd-card">
            <div class="rd-card-header"><h1 class="mb-0">@ViewData["Title"]</h1></div>

            <form asp-action="@(isNew ? "Create" : "Edit")" method="post" enctype="multipart/form-data" novalidate>
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>
                <input type="hidden" asp-for="EventId" />
                <input type="hidden" asp-for="ExistingBannerUrl" />

                <div class="mb-3">
                    <label asp-for="Name" class="form-label"></label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>

                <div class="row">
                    <div class="col-md-7 mb-3">
                        <label asp-for="EventType" class="form-label"></label>
                        <select asp-for="EventType" class="form-select">
                            <option value="">Choose a type...</option>
                            @foreach (var t in EventFormViewModel.EventTypes)
                            {
                                <option value="@t" selected="@(t == Model.EventType)">@t</option>
                            }
                        </select>
                        <span asp-validation-for="EventType" class="text-danger small"></span>
                    </div>
                    <div class="col-md-5 mb-3">
                        <label asp-for="DistanceKm" class="form-label"></label>
                        <input asp-for="DistanceKm" type="number" step="0.1" min="0.1" class="form-control" />
                        <span asp-validation-for="DistanceKm" class="text-danger small"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="EventDate" class="form-label"></label>
                        <input asp-for="EventDate" type="datetime-local" class="form-control" />
                        <span asp-validation-for="EventDate" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="Province" class="form-label"></label>
                        <select asp-for="Province" class="form-select">
                            <option value="">Choose a province...</option>
                            @foreach (var p in EventListViewModel.Provinces)
                            {
                                <option value="@p" selected="@(p == Model.Province)">@p</option>
                            }
                        </select>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Location" class="form-label"></label>
                    <input asp-for="Location" class="form-control" />
                    <span asp-validation-for="Location" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label"></label>
                    <textarea asp-for="Description" rows="4" class="form-control"></textarea>
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>

                @if (!isNew)
                {
                    <div class="mb-3">
                        <label asp-for="Status" class="form-label"></label>
                        <select asp-for="Status" class="form-select">
                            @foreach (var s in EventFormViewModel.Statuses)
                            {
                                <option value="@s" selected="@(s == Model.Status)">@s</option>
                            }
                        </select>
                    </div>
                }

                <div class="mb-4">
                    <label asp-for="BannerFile" class="form-label"></label>
                    @if (!string.IsNullOrWhiteSpace(Model.ExistingBannerUrl))
                    {
                        <div class="mb-2"><img src="@Model.ExistingBannerUrl" class="rd-event-banner rounded" style="max-width:320px;height:auto;" alt="Current banner" /></div>
                    }
                    <input asp-for="BannerFile" type="file" accept="image/jpeg,image/png,image/webp" class="form-control" />
                    <div class="form-text">JPG, PNG or WEBP, up to 5 MB. @(isNew ? "" : "Leave empty to keep the current banner.")</div>
                    <span asp-validation-for="BannerFile" class="text-danger small"></span>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-rd">@(isNew ? "Create event" : "Save changes")</button>
                    <a asp-action="Index" class="btn btn-rd-outline">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}