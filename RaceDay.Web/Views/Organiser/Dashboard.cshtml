@model DashboardViewModel
@{
    ViewData["Title"] = "Organiser dashboard";
}
<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
    <div class="rd-card-header mb-0"><h1 class="mb-0">Dashboard</h1></div>
    <a asp-controller="OrganiserEvents" asp-action="Create" class="btn btn-rd">+ Create event</a>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-4"><div class="rd-card rd-stat"><div class="rd-stat-num">@Model.Events.Count</div><div class="rd-stat-label">Events created</div></div></div>
    <div class="col-md-4"><div class="rd-card rd-stat"><div class="rd-stat-num">@Model.TotalEnrolments</div><div class="rd-stat-label">Total enrolments</div></div></div>
    <div class="col-md-4"><div class="rd-card rd-stat"><div class="rd-stat-num">@Model.Upcoming.Count</div><div class="rd-stat-label">Upcoming events</div></div></div>
</div>

<div class="rd-card mb-4">
    <div class="rd-card-header"><h2 class="mb-0">Upcoming event dates</h2></div>
    @if (!Model.Upcoming.Any())
    {
        <p class="text-muted mb-0">No upcoming events. Create one to get started.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead><tr><th>Date</th><th>Event</th><th>Type</th><th>Location</th><th class="text-end">Enrolments</th></tr></thead>
                <tbody>
                @foreach (var e in Model.Upcoming)
                {
                    <tr>
                        <td>@e.EventDate.ToString("ddd, dd MMM yyyy HH:mm")</td>
                        <td class="fw-semibold">@e.Name</td>
                        <td>@e.EventType &middot; @e.DistanceKm.ToString("0.##") km</td>
                        <td>@e.Location</td>
                        <td class="text-end">@e.EnrolmentCount</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>

<div class="rd-card">
    <div class="rd-card-header"><h2 class="mb-0">Enrolments per event</h2></div>
    @if (!Model.Events.Any())
    {
        <p class="text-muted mb-0">You haven't created any events yet.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead><tr><th>Event</th><th>Date</th><th>Status</th><th class="text-end">Enrolments</th></tr></thead>
                <tbody>
                @foreach (var e in Model.Events)
                {
                    <tr>
                        <td class="fw-semibold">@e.Name</td>
                        <td>@e.EventDate.ToString("dd MMM yyyy")</td>
                        <td><partial name="_StatusBadge" model="e.Status" /></td>
                        <td class="text-end">@e.EnrolmentCount</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>