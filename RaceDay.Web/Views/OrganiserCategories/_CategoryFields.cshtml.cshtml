@model CategoryFormViewModel
<input type="hidden" asp-for="CategoryId" />
<input type="hidden" asp-for="EventId" />
<input type="hidden" asp-for="EventName" />

<div class="mb-3">
    <label asp-for="Name" class="form-label"></label>
    <input asp-for="Name" class="form-control" placeholder="e.g. 10 km or Half Marathon" />
    <span asp-validation-for="Name" class="text-danger small"></span>
</div>
<div class="mb-3">
    <label asp-for="DistanceKm" class="form-label"></label>
    <input asp-for="DistanceKm" type="number" step="0.1" min="0.1" class="form-control" />
    <span asp-validation-for="DistanceKm" class="text-danger small"></span>
</div>
<div class="mb-3">
    <label asp-for="MaxParticipants" class="form-label"></label>
    <input asp-for="MaxParticipants" type="number" min="1" class="form-control" />
    <span asp-validation-for="MaxParticipants" class="text-danger small"></span>
</div>
<div class="mb-3">
    <label asp-for="EntryFee" class="form-label"></label>
    <input asp-for="EntryFee" type="number" step="0.01" min="0" class="form-control" />
    <span asp-validation-for="EntryFee" class="text-danger small"></span>
</div>