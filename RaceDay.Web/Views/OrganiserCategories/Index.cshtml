@model CategoriesPageViewModel
@{
    var ev = Model.Event;
    ViewData["Title"] = "Categories: " + ev.Name;
}
<a asp-controller="OrganiserEvents" asp-action="Index" class="text-decoration-none">&larr; My events</a>
<div class="rd-card-header mt-3">
    <h1 class="mb-0">Categories</h1>
    <div class="rd-meta">@ev.Name &middot; @ev.EventDate.ToString("dd MMM yyyy")</div>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="rd-card">
            @if (Model.Categories.Count == 0)
            {
                <p class="text-muted mb-0">No categories yet. Add the first one, for example "10 km" or "Half Marathon".</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead><tr><th>Category</th><th>Distance</th><th>Max</th><th>Fee</th><th></th></tr></thead>
                        <tbody>
                        @foreach (var c in Model.Categories)
                        {
                            <tr>
                                <td class="fw-semibold">@c.Name</td>
                                <td>@c.DistanceKm.ToString("0.##") km</td>
                                <td>@c.MaxParticipants</td>
                                <td>R@(c.EntryFee.ToString("0.00"))</td>
                                <td class="text-end text-nowrap">
                                    <a asp-action="Edit" asp-route-id="@c.CategoryId" class="btn btn-rd-outline btn-sm">Edit</a>
                                    <form asp-action="Delete" asp-route-id="@c.CategoryId" method="post" class="d-inline"
                                          onsubmit="return confirm('Delete this category?');">
                                        <input type="hidden" name="eventId" value="@ev.EventId" />
                                        <button type="submit" class="btn btn-outline-danger btn-sm">Delete</button>
                                    </form>
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <div class="col-lg-4">
        <div class="rd-card">
            <div class="rd-card-header"><h2 class="mb-0">Add category</h2></div>
            <form asp-action="Create" method="post" novalidate>
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>
                <partial name="_CategoryFields" model="Model.NewCategory" />
                <button type="submit" class="btn btn-rd w-100">Add category</button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}