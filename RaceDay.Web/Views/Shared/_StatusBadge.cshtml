@* Usage: <partial name="_StatusBadge" model="enrolment.Status" />
   Works for event status, enrolment status and payment status. *@
@model string
@{
    var key = (Model ?? "").Trim().ToLowerInvariant();
    var cssClass = key switch
    {
        "confirmed" or "paid"      => "rd-status-confirmed",   // green
        "registered" or "pending"  => "rd-status-pending",     // amber
        "cancelled" or "dnf"       => "rd-status-cancelled",   // red
        _                          => "rd-status-other"        // grey: Refunded, Completed, DNS...
    };
}
<span class="rd-status @cssClass">@(string.IsNullOrWhiteSpace(Model) ? "Unknown" : Model)</span>